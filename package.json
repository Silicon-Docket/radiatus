{
  "name": "radiatus",
  "version": "1.0.0",
  "description": "An open-source dashboard for managing Stripe subscriptions with Cloudflare",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute radiatus --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute radiatus --remote --file=./migrations/0001_init.sql",
    "lint": "node --check src/worker.js && node --check test/worker.test.js",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Silicon-Docket/radiatus.git"
  },
  "keywords": [
    "cloudflare",
    "d1",
    "stripe",
    "admin-dashboard",
    "template"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true
}
