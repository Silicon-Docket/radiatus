{
  "name": "radiatus",
  "version": "1.0.0",
  "description": "An open-source dashboard for managing Stripe subscriptions with Cloudflare",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply radiatus --local",
    "db:migrate:remote": "wrangler d1 migrations apply radiatus --remote",
    "lint": "node --check src/worker.js && node --check test/worker.test.js",
    "test": "node --test"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Silicon-Docket/radiatus.git"
  },
  "keywords": [
    "cloudflare",
    "d1",
    "stripe",
    "admin-dashboard",
    "template"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true
}
